# Copy to .env and fill in. Never commit .env.
# Anthropic API key for live mode (image reading with Claude vision, model-assisted intake, audit critique).
ANTHROPIC_API_KEY=your-key-here
# Model used by every agent (must support images and structured outputs).
ANTHROPIC_MODEL=claude-opus-5-5
# auto = use Anthropic when a key is set, otherwise the offline mode; or force "anthropic" / "offline".
SILVERFILE_LLM_MODE=auto
# Model effort for agent calls: low | medium | high.
SILVERFILE_EFFORT=low
# Server-side refusal fallbacks (Anthropic beta). Set to false to disable.
SILVERFILE_FALLBACKS=true
# Where case data, uploads and drafts are stored.
SILVERFILE_VAR_DIR=./var
# Context-window strategy for model calls (selective recall). false = replay the whole conversation.
SILVERFILE_CONTEXT_STRATEGY=true
